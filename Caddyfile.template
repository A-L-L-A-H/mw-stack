{
	email {$MW_ACME_EMAIL:ops@mw.local}
	on_demand_tls {
		ask http://mw-cp:4440/paas/caddy/ask
	}
}

*.paas.{$MW_DOMAIN:mw.local} {
	reverse_proxy mw-cp:4440
}

echo.{$MW_DOMAIN:mw.local} {
	reverse_proxy mw-echo:4310
}

lab.{$MW_DOMAIN:mw.local} {
	reverse_proxy mw-lab:4400
}

mission.{$MW_DOMAIN:mw.local} {
	reverse_proxy mw-mission:4410
}

cp.{$MW_DOMAIN:mw.local} {
	reverse_proxy mw-cp:4440
}

dock.{$MW_DOMAIN:mw.local} {
	# Dock realtime uses Server-Sent Events on /api/v1/dock/realtime.
	# Disable response buffering so connected/heartbeat frames flush immediately.
	reverse_proxy mw-dock:3000 {
		flush_interval -1
	}
}

board.{$MW_DOMAIN:mw.local} {
	reverse_proxy mw-board:3001
}

design.{$MW_DOMAIN:mw.local} {
