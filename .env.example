# MoonWitness Sovereign Fleet Configuration
# Copy to .env or let install.sh generate cryptographic secrets automatically.

# Active default profile: lite | id | ops | saas | isp | epistemic | portal | studio | rocksoul | business | tunnel | proxy | full
MW_PROFILE=lite

# Domain & Reverse Proxy (used by Caddyfile.template)
MW_DOMAIN=mw.local
MW_ACME_EMAIL=ops@mw.local

# Shared Sovereign Auth & Session Secrets (generated via `openssl rand -hex 24`)
MW_API_SECRET=replace_with_openssl_rand_hex_24
MW_JWT_SECRET=replace_with_openssl_rand_hex_24
MW_ENCRYPTION_KEY=replace_with_openssl_rand_hex_24
RID_BOOTSTRAP_SECRET=

# RID token contract
# Issuer must match exactly across mw-rid and all token consumers.
MW_RID_ISSUER=https://id.${MW_DOMAIN:-mw.local}
# mw-rid stamps this audience into issued tokens.
MW_RID_DEFAULT_AUDIENCE=urn:moonwitness:api
# mw-echo and mw-dock reject tokens whose audience does not match this value.
MW_RID_AUDIENCE=urn:moonwitness:api
# RID signing key path used by mw-rid for RS256 tokens and JWKS.
MW_RID_SIGNING_KEY_PATH=
# Shared secret for POST /api/v1/dock/realtime/publish when no RID auth is present.
DOCK_REALTIME_TOKEN=

# PostgreSQL (used by `saas` and `full` profiles)
POSTGRES_DB=moonwitness
POSTGRES_USER=moonwitness
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_24

# Service Ports (Host Bindings)
MW_ECHO_PORT=4310
MW_LAB_PORT=4400
MW_MISSION_PORT=4410
MW_CORPUS_PORT=4420
MW_NEXUS_PORT=4430
MW_CP_PORT=4440
MW_LORE_PORT=4450
MW_MYLOVE_PORT=4460
MW_STUDIO_PORT=4470
MW_RID_PORT=4480
MW_ROCKSOUL_GATEWAY_PORT=4510
MW_ROCKSOUL_CORE_PORT=4520
MW_ROCKSOUL_MCP_PORT=4530
MW_ROCKSOUL_SANDBOX_PORT=4540
MW_DOCK_PORT=3000
MW_BOARD_PORT=3001
MW_DESIGN_PORT=8080
MW_ISP_PORT=8091

# Cloudflare Tunnel (used by `tunnel` and `full` profiles)
CLOUDFLARE_TUNNEL_TOKEN=

# Image Tag (default: latest)
MW_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Free-Tier Cloud Offload & Backup/Fallback (All Optional, 0 Credit Card)
# Leave blank to run purely offline/local without external calls.
# -----------------------------------------------------------------------------
# PaaS Catalog & Data Offload
MW_TEMPLATES_DIR=/opt/mw-templates
QDRANT_URL=
TURSO_DATABASE_URL=

# Free LLM Failover Pool (priority: Gemini 50 -> Groq 60 -> OpenRouter 70 -> NVIDIA NIM 80)
ROCKSOUL_DEFAULT_CLASSIFICATION=cloud_eligible
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Zero-Card Alerts, Email & OTLP Observability
NTFY_TOPIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# 3-2-1 Automated Backup Config
BACKUP_DIR=/var/backups/mw-stack
BACKUP_RETENTION_DAYS=7
BACKUP_RCLONE_REMOTE=
